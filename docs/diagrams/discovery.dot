digraph discovery {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.28];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#3b5b8c", fillcolor="#eef3fb", width=4.2];
  edge  [color="#555555", arrowsize=0.7];
  s1 [label="1. Known cached devices + configured static addresses\n(wake monitors; no new traffic beyond their normal probes)"];
  s2 [label="2. OS neighbor table (rtnetlink dump + live events)\npassive: zero packets sent"];
  s3 [label="3. mDNS resolution of configured .local names"];
  s4 [label="4. System hostname resolution (getaddrinfo)"];
  s5 [label="5. Reachability: ICMP echo first, TCP/22 at a low rate\n(monitors, per device, with hysteresis)"];
  s6 [label="6. Bounded active scan of allowlisted, directly attached /22-or-smaller\nprivate IPv4 networks: ICMP sweep, ARP reveals ICMP-silent hosts,\nTCP/22 only for hosts not checked in 10 min", fillcolor="#fff7e6", color="#b07d2b"];
  s7 [label="7. SSH host-key verification (ssh-keyscan) of responsive\nunmatched hosts: re-identifies devices that moved"];
  s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7;
}
